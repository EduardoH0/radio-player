{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "radio-metadata",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-10",

    "vars": {
        "ENVIRONMENT": "development"
    },

    "env": {
        "production": {
            "vars": {
                "ENVIRONMENT": "production"
            }
        }
    }
}
